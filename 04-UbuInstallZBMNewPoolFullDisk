# ─── User ──────────────────────────────────────────────────────
# 1. Create primary user group (1000) and system audit group
groupadd -g 1000 "${TARGET_USER}"
groupadd -rf audit

# 2. Add user without creating home directory (already mounted as a ZFS dataset)
useradd -M -u 1000 -g 1000 -d "/home/${TARGET_USER}" -s /bin/bash "${TARGET_USER}"
usermod -aG sudo,audit "${TARGET_USER}"

# 3. Populate skeleton files on the ZFS user dataset
cp -rT /etc/skel "/home/${TARGET_USER}"
chown -R "${TARGET_USER}:${TARGET_USER}" "/home/${TARGET_USER}"

# 4. Create reusable vault-linking script for future cloned Boot Environments
cat <<'SCRIPT' > /usr/local/bin/link-vault.sh
#!/usr/bin/env bash
set -euo pipefail

VAULT="/mnt/data"
USER_HOME="$HOME"

DIRS=(
    "Documents"
    "Downloads"
    "Music"
    "Pictures"
    "Videos"
    "Projects"
    ".local/share/Steam"
)

for dir in "${DIRS[@]}"; do
    TARGET="${VAULT}/${dir}"
    LINK="${USER_HOME}/${dir}"

    mkdir -p "${TARGET}"
    mkdir -p "$(dirname "${LINK}")"

    if [ -d "${LINK}" ] && [ ! -L "${LINK}" ]; then
        cp -rn "${LINK}/." "${TARGET}/" 2>/dev/null || true
        rm -rf "${LINK}"
    fi

    ln -sfn "${TARGET}" "${LINK}"
done
SCRIPT
chmod +x /usr/local/bin/link-vault.sh

# 5. Set vault permissions (1000:1000) and link user folders to /mnt/data
mkdir -p /mnt/data
chown -R 1000:1000 /mnt/data
su - "${TARGET_USER}" -c "/usr/local/bin/link-vault.sh"

zfs allow "${TARGET_USER}" compression,mountpoint,create,mount,snapshot,destroy,send,receive,hold,release zroot/ROOT/"${root_dataset}"/home/${user}


# Cleanup
apt-get autoremove -y
apt-get clean
rm -rf /var/lib/apt/lists/*
CHROOT

# Set root passwd
print "Set root password"
arch-chroot /mnt /bin/passwd

# Set user passwd
print "Set user password"
user=$(cat /tmp/user_name)
arch-chroot /mnt /bin/passwd "$user"

# ─── Symlink: systemd-resolved ─────────
print "Symlink systemd-resolved"
rm -f /mnt/etc/resolv.conf
ln -s /run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

# Umount all parts
print "Umount all parts"
umount /mnt/boot/efi
umount -n -R /mnt
zfs unmount -a

# Export zpool
print "Export zpool"
zpool export zroot

# Finish
echo -e "\e[32mAll OK"
