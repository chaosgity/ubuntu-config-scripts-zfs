## Verify the change
#timedatectl | grep "Time zone"

# ─── 2. Locale-gen: select locales to enable ───────────────────

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  Locale settings"
echo "═══════════════════════════════════════════════════════════"
echo ""

echo "Use de_CH.UTF8 (Swiss German; Switzerland) and en_US.UTF-8 (US English; United States) as locale setting?"
read -rp "  [Y/n]: " answer <&3

if [[ ! "$answer" =~ ^[Nn]$ ]]; then
    sed -i 's/^# *\(de_CH.UTF-8 UTF-8\)/\1/' /etc/locale.gen
	sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
    echo "Locale setting: Swiss German and US English"
		locale-gen
		echo "locale-gen done."
else
while true; do
	mapfile -t LOCALES < <(grep -E '^\s*#?\s*\S+\.\S+\s+\S+' /etc/locale.gen)

	echo "Available locales:"
	echo ""
	for i in "${!LOCALES[@]}"; do
    	entry="${LOCALES[$i]#*#}"
    	entry="$(echo "$entry" | xargs)"
    	status=" "
    	[[ "${LOCALES[$i]}" =~ ^# ]] && status="·"
    	printf "  %s %2d  %s\n" "$status" "$((i+1))" "$entry"
	done
	echo ""
	echo "  (· = currently commented out)"
	echo ""

	read -rp "Select locales to enable (numbers, space-separated): " selection <&3

	for num in $selection; do
    	idx=$((num - 1))
    	if [[ -z "${LOCALES[$idx]}" ]]; then
        	echo "  ⚠ Skipping invalid number: $num"
        	continue
    	fi
    	entry="$(echo "${LOCALES[$idx]}" | sed 's/^#\s*//' | xargs)"
    	sed -i "s/^# *(\(.*${entry}.*\))/\1/" /etc/locale.gen
    	echo "  ✓ Enabled: $entry"
	done

	#echo ""
	#read -rp "Run locale-gen now? [Y/n]: " confirm <&3
	#if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
    #	locale-gen
    #	echo "locale-gen done."
	#fi

	echo ""
    read -rp "Run locale-gen now? [Y/n]: " confirm <&3

    if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
		locale-gen
		echo "locale-gen done."
        break
    fi
    echo "Re-doing..."
    echo ""
done

fi

# ─── 3. Locale: set /etc/default/locale ────────────────────────

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  Locale configuration"
echo "═══════════════════════════════════════════════════════════"
echo ""

echo "Configure your locale settings: "
echo "Default: Language (US English); locale settings (Swiss German)"
echo ""

while true; do
    echo "Confirm by pressing Enter or typing your choice:"

    read -rp "LANG [en_US.UTF-8]: " LANG <&3
    LANG="${LANG:-en_US.UTF-8}"

    read -rp "LC_MESSAGES [en_US.UTF-8]: " LC_MESSAGES <&3
    LC_MESSAGES="${LC_MESSAGES:-en_US.UTF-8}"

    read -rp "LC_TIME [de_CH.UTF-8]: " LC_TIME <&3
    LC_TIME="${LC_TIME:-de_CH.UTF-8}"

    read -rp "LC_NUMERIC [de_CH.UTF-8]: " LC_NUMERIC <&3
    LC_NUMERIC="${LC_NUMERIC:-de_CH.UTF-8}"

    read -rp "LC_MONETARY [de_CH.UTF-8]: " LC_MONETARY <&3
    LC_MONETARY="${LC_MONETARY:-de_CH.UTF-8}"

    read -rp "LC_COLLATE [de_CH.UTF-8]: " LC_COLLATE <&3
    LC_COLLATE="${LC_COLLATE:-de_CH.UTF-8}"

    read -rp "LC_PAPER [de_CH.UTF-8]: " LC_PAPER <&3
    LC_PAPER="${LC_PAPER:-de_CH.UTF-8}"

    read -rp "LC_NAME [de_CH.UTF-8]: " LC_NAME <&3
    LC_NAME="${LC_NAME:-de_CH.UTF-8}"

    read -rp "LC_ADDRESS [de_CH.UTF-8]: " LC_ADDRESS <&3
    LC_ADDRESS="${LC_ADDRESS:-de_CH.UTF-8}"

    read -rp "LC_TELEPHONE [de_CH.UTF-8]: " LC_TELEPHONE <&3
    LC_TELEPHONE="${LC_TELEPHONE:-de_CH.UTF-8}"

    read -rp "LC_MEASUREMENT [de_CH.UTF-8]: " LC_MEASUREMENT <&3
    LC_MEASUREMENT="${LC_MEASUREMENT:-de_CH.UTF-8}"

    read -rp "LC_IDENTIFICATION [de_CH.UTF-8]: " LC_IDENTIFICATION <&3
    LC_IDENTIFICATION="${LC_IDENTIFICATION:-de_CH.UTF-8}"

    echo ""
    echo "  LANG=              $LANG"
    echo "  LC_MESSAGES=       $LC_MESSAGES"
    echo "  LC_TIME=           $LC_TIME"
    echo "  LC_NUMERIC=        $LC_NUMERIC"
    echo "  LC_MONETARY=       $LC_MONETARY"
    echo "  LC_COLLATE=        $LC_COLLATE"
    echo "  LC_PAPER=          $LC_PAPER"
    echo "  LC_NAME=           $LC_NAME"
    echo "  LC_ADDRESS=        $LC_ADDRESS"
    echo "  LC_TELEPHONE=      $LC_TELEPHONE"
    echo "  LC_MEASUREMENT=    $LC_MEASUREMENT"
    echo "  LC_IDENTIFICATION= $LC_IDENTIFICATION"
    echo ""
    read -rp "Apply? [y/N]: " confirm <&3

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        break
    fi
    echo "Re-entering..."
    echo ""
done

exec 3<&-

