nofsck="yes"
add_dracutmodules+=" zfs "
force_drivers+=" zfs "
omit_dracutmodules+=" btrfs "
add_dracutmodules+=" systemd "
EOF

echo 'install_items+=" /etc/zfs/zroot.key "' > /etc/dracut.conf.d/zfskey.conf
