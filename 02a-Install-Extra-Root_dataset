#!/usr/bin/env bash
set -euo pipefail

print () {
    echo -e "\n\033[1m> $1\033[0m\n"
}

ask () {
    read -p "> $1 " -r
    echo
}

# ─── Pre-flight Checks ──────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
    echo "Error: Please run this script as root."
    exit 1
fi

# Tests
ls /sys/firmware/efi/efivars > /dev/null &&   \
    ping ubuntu.com -c 1 > /dev/null &&    \
    timedatectl set-ntp true > /dev/null &&   \
    printf "Tests ok"

# Install helpers
print "Install helpers"
apt update
apt install -y debootstrap gdisk zfsutils-linux dosfstools arch-install-scripts

modprobe zfs 2>/dev/null || true

# ─── Interactive Disk & EFI Partition Selection ─────────────
echo "Select the disk containing your EFI partition and ZFS pool:"
mapfile -t DISKS < <(find /dev/disk/by-id/ -maxdepth 1 -mindepth 1 ! -name '*-part*' ! -name 'wwn-*' -printf '%f\n' | sort)

if [[ ${#DISKS[@]} -eq 0 ]]; then
    echo "Error: No disks found in /dev/disk/by-id/."
    exit 1
fi

PS3="Select disk number: "
select ENTRY in "${DISKS[@]}"; do
    if [[ -n "${ENTRY:-}" ]]; then
        DISK="/dev/disk/by-id/${ENTRY}"
        echo "==> Selected disk: ${DISK}"
        break
    else
        echo "Invalid selection. Try again."
    fi
done

EFI_PART=""
for PART in "${DISK}"-part*; do
    if [[ -e "$PART" ]] && [[ "$(blkid -s TYPE -o value "$PART" 2>/dev/null)" == "vfat" ]]; then
        EFI_PART="$PART"
        break
    fi
done

if [[ -z "$EFI_PART" ]]; then
    echo "Error: Could not automatically find a vfat/EFI partition on ${DISK}."
    exit 1
fi

echo "==> Detected EFI partition: ${EFI_PART}"

# ─── Set name of source storage pool ───────────────────────────────────────────────────
print "Set name of your existing ZFS storage pool"
echo ""
echo "═══════════════════════════════════════════════════════════════════════════════════"
echo "  ZFS STORAGE POOL"
echo "  Source pool dataset configuration; typing name of the source storage pool:"
echo "  (Default: zroot [zroot/ROOT/ubu1])"
echo "═══════════════════════════════════════════════════════════════════════════════════"
echo ""

while true; do
    echo "Confirm by pressing Enter or typing your choice:"
    read -r -p "Pool_Name [zroot]: " POOL_NAME
    POOL_NAME=${POOL_NAME:-zroot}

    echo ""
    echo "Name of the source storage pool is: $POOL_NAME"
    echo ""

    read -r -p "Apply? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        break
    fi

    echo "Re-entering..."
    echo ""
done

# ─── Import Pool & Load Key Interactively ───────────────────
echo "==> Importing pool '${POOL_NAME}' without mounting existing datasets..."

print "Reimport ZFS storage pool"
if zpool status "${POOL_NAME}" &>/dev/null
then
  zpool export "${POOL_NAME}"
fi
zpool import -d /dev/disk/by-id -R /mnt "${POOL_NAME}" -N -f

echo "==> Ensuring cachefile=none on '${POOL_NAME}'..."
zpool set cachefile=none "${POOL_NAME}"

print "Load ZFS keys"
echo "==> Unlocking '${POOL_NAME}' (enter your pool passphrase)..."
zfs load-key -L prompt "${POOL_NAME}"

# ─── 4. Interactive Source Dataset Selection ───────────────────
mapfile -t DATASETS < <(zfs list -H -o name -d 1 "${POOL_NAME}/ROOT" | tail -n +2)

if [[ ${#DATASETS[@]} -eq 0 ]]; then
    echo "Error: No existing datasets found under ${POOL_NAME}/ROOT."
    exit 1
fi

echo ""
echo "Select your existing root dataset (Default: ubu0) to copy zroot.key and hostid from:"
PS3="Select dataset number: "
select SRC_DATASET in "${DATASETS[@]}"; do
    if [[ -n "${SRC_DATASET:-}" ]]; then
        echo "==> Selected source dataset: ${SRC_DATASET}"
        break
    else
        echo "Invalid selection. Try again."
    fi
done

# ─── Set extra root dataset ────────────────────────────────────────────────────────────
print "Set extra root dataset"
echo ""
echo "═══════════════════════════════════════════════════════════════════════════════════"
echo "  ROOT DATASET (extra) / BOOT ENVIRONMENT (extra) / ROOT FILESYSTEM DATASET (extra)"
echo "  Root dataset configuration; typing name of the extra slash dataset:"
echo "  (Default: ubu1 [zroot/ROOT/ubu1])"
echo "═══════════════════════════════════════════════════════════════════════════════════"
echo ""

while true; do
    echo "Confirm by pressing Enter or typing your choice:"
    read -r -p "root_dataset [ubu1]: " ROOT_DATASET
    ROOT_DATASET=${ROOT_DATASET:-ubu1}

    echo ""
    echo "Name of the extra slash dataset is: $ROOT_DATASET"
    echo ""

    read -r -p "Apply? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        break
    fi

    echo "Re-entering..."
    echo ""
done

TARGET_DATASET="${POOL_NAME}/ROOT/${ROOT_DATASET}"

# ─── Create & Mount Extra Root Dataset ────────────────────
if zfs list "${TARGET_DATASET}" >/dev/null 2>&1; then
    echo "Error: Target dataset '${TARGET_DATASET}' already exists. Aborting to prevent data loss."
    exit 1
fi

echo "==> Creating and mounting '${TARGET_DATASET}'..."
zfs create -o mountpoint=/ -o canmount=noauto "${TARGET_DATASET}"
zfs mount "${TARGET_DATASET}"

echo "==> Mounting EFI partition (${EFI_PART}) at /mnt/boot/efi..."
mkdir -p /mnt/boot/efi
mount "${EFI_PART}" /mnt/boot/efi


# ─── Set home and user dataset ───────────────────────────────────────────────
print "Create home and user dataset / set your username"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  USER DATASET CONFIGURATION "
echo "  Typing name of the user dataset respectively username:"
echo "  (Default: chaos [zroot/ROOT/ubu1/home/chaos])"
echo "════════════════════════════════════════════════════════════════"
echo ""

zfs create -o mountpoint=/home "${TARGET_DATASET}/home"
while true; do
    echo "Confirm by pressing Enter or typing your choice:"

    read -rp "Username [chaos]: " TARGET_USER
    TARGET_USER="${TARGET_USER:-chaos}"
    
    echo ""
    echo "  Name of the user dataset / user is: $TARGET_USER"
    echo ""
    read -rp "Apply? [y/N]: " confirm
    
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
            break
    fi
    echo "Re-entering..."
    echo ""
done

    zfs create "${TARGET_DATASET}/home/${TARGET_USER}"
    echo "$TARGET_USER" > /tmp/user_name

# ─── Copy Encryption Key & HostID from source root dataset ───────────────
echo "==> Mounting '${SRC_DATASET}' read-only to copy keyfile and hostid..."
mkdir -p /tmp/source_root_dataset /mnt/etc/zfs
mount -t zfs -o ro "${SRC_DATASET}" /tmp/source_root_dataset

cp /tmp/ubuntu/etc/zfs/zroot.key /mnt/etc/zfs/zroot.key
chmod 000 /mnt/etc/zfs/zroot.key
cp /tmp/source_root_dataset/etc/hostid /mnt/etc/hostid

umount /tmp/source_root_dataset
rmdir /tmp/source_root_dataset
echo "==> Keyfile and hostid copied successfully."



# Update device symlinks
print "Update device symlinks"
udevadm trigger

# The "old" kernel links mess up zfsbootmenu generation, so remove them
# Don't need them for an initial install anyway
print "Remove old kernel links"
rm /boot/vmlinuz.old /boot/initrd.img.old

# ─── Bootstrap ───────────────────────────────────────────────
print "minbase & essential boot packages in one pass"
debootstrap \
    --arch=amd64 \
    --variant=minbase \
    --include=apt,curl,vim,openssh-server,sudo,systemd,systemd-sysv,locales,keyboard-configuration,console-setup \
    resolute \
    /mnt \
    https://ftp.uni-stuttgart.de/ubuntu

# ─── Generate /etc/fstab (EFI only) ─────────────────────────
echo "==> Generating /etc/fstab for EFI partition..."
genfstab -U /mnt | grep -iE "efi|vfat" >> /mnt/etc/fstab

# Generate fstab excluding ZFS entries
#print "Generate fstab excluding ZFS entries"
#genfstab -U /mnt | grep -v "zroot" | tr -s '\n' | sed 's/\/mnt//'  > /mnt/etc/fstab

# ─── Create hostname ───────────────────────────────────────────────
print "Set hostname"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  HOSTNAME CONFIGURATION; typing name of the hostname:"
echo "  (Default: zubu1)"
echo "════════════════════════════════════════════════════════════════"
echo ""

while true; do
    echo "Confirm by pressing Enter or typing your choice:"
    read -r -p "Hostname [zubu1]: " 
    HOST_NAME=${HOST_NAME:-zubu1}

    echo ""
    echo "Name of the hostname is: $HOST_NAME"
    echo ""

    read -r -p "Apply? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        break
    fi

    echo "Re-entering..."
    echo ""
done

# Set hostname
#read -r -p 'Please enter hostname : ' hostname
echo "$HOST_NAME" > /mnt/etc/hostname

# Configure /etc/hosts
print "Configure hosts file"
cat > /mnt/etc/hosts <<EOF
#<ip-address>	<hostname.domain.org>	<hostname>
127.0.0.1	    localhost   	        $HOST_NAME
::1   		    localhost              	$HOST_NAME
EOF

# Copy files into the new install
print "Copy files into the new install"
cp /etc/hostid /mnt/etc/hostid
cp /etc/resolv.conf /mnt/etc/

# Copy root_dataset into the new install
cp /tmp/root_dataset /mnt/var/tmp/

# Copy disk into the new install
cp /tmp/disk /mnt/var/tmp/

# Copy user_name into the new install
cp /tmp/user_name /mnt/var/tmp/

# Prevent services from starting during install
#tee /mnt/usr/sbin/policy-rc.d > /dev/null <<'EOF'
