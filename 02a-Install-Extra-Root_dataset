#!/usr/bin/env bash

set -e

print () {
    echo -e "\n\033[1m> $1\033[0m\n"
}

ask () {
    read -p "> $1 " -r
    echo
}

# Tests
ls /sys/firmware/efi/efivars > /dev/null &&   \
    ping ubuntu.com -c 1 > /dev/null &&    \
    timedatectl set-ntp true > /dev/null &&   \
    printf "Tests ok"

# Install helpers
print "Install helpers"
apt update
apt install -y debootstrap gdisk zfsutils-linux dosfstools arch-install-scripts

# Generate /etc/hostid
print "Generate /etc/hostid"
zgenhostid -f 0x00bab10c







# ─── 1. Pre-flight Checks ──────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
    echo "Error: Please run this script as root."
    exit 1
fi

modprobe zfs 2>/dev/null || true

# ─── 2. Interactive Disk & EFI Partition Selection ─────────────
echo "Select the disk containing your EFI partition and ZFS pool:"
mapfile -t DISKS < <(find /dev/disk/by-id/ -maxdepth 1 -mindepth 1 ! -name '*-part*' ! -name 'wwn-*' -printf '%f\n' | sort)

if [[ ${#DISKS[@]} -eq 0 ]]; then
    echo "Error: No disks found in /dev/disk/by-id/."
    exit 1
fi

PS3="Select disk number: "
select ENTRY in "${DISKS[@]}"; do
    if [[ -n "${ENTRY:-}" ]]; then
        DISK="/dev/disk/by-id/${ENTRY}"
        echo "==> Selected disk: ${DISK}"
        break
    else
        echo "Invalid selection. Try again."
    fi
done

EFI_PART=""
for PART in "${DISK}"-part*; do
    if [[ -e "$PART" ]] && [[ "$(blkid -s TYPE -o value "$PART" 2>/dev/null)" == "vfat" ]]; then
        EFI_PART="$PART"
        break
    fi
done

if [[ -z "$EFI_PART" ]]; then
    echo "Error: Could not automatically find a vfat/EFI partition on ${DISK}."
    exit 1
fi

echo "==> Detected EFI partition: ${EFI_PART}"











# Set DISK
select ENTRY in $(ls /dev/disk/by-id/);
do
    DISK="/dev/disk/by-id/$ENTRY"
    echo "Mounting $ENTRY."
    break
done

print "Load ZFS module"
modprobe zfs

print "Reimport zpool"
if zpool status zroot &>/dev/null
then
  zpool export zroot
fi
zpool import -d /dev/disk/by-id -R /mnt zroot -N -f

print "Load ZFS keys"
zfs load-key -L prompt zroot

# ─── Set extra root dataset ────────────────────────────────────────────────────────────
print "Set extra root dataset"
echo ""
echo "═══════════════════════════════════════════════════════════════════════════════════"
echo "  ROOT DATASET (extra) / BOOT ENVIRONMENT (extra) / ROOT FILESYSTEM DATASET (extra)"
echo "  Root dataset configuration; typing name of the extra slash dataset:"
echo "  (Default: ubu1 [zroot/ROOT/ubu1])"
echo "═══════════════════════════════════════════════════════════════════════════════════"
echo ""

while true; do
    echo "Confirm by pressing Enter or typing your choice:"
    read -r -p "root_dataset [ubu1]: " ROOT_DATASET
    ROOT_DATASET=${ROOT_DATASET:-ubu1}

    echo ""
    echo "Name of the extra slash dataset is: $ROOT_DATASET"
    echo ""

    read -r -p "Apply? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        break
    fi

    echo "Re-entering..."
    echo ""
done

# ─── Set home and user dataset ───────────────────────────────────────────────
print "Create home and user dataset / set your username"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  USER DATASET CONFIGURATION "
echo "  Typing name of the user dataset respectively username:"
echo "  (Default: chaos [zroot/ROOT/ubu0/home/chaos])"
echo "════════════════════════════════════════════════════════════════"
echo ""

zfs create -o mountpoint=/home zroot/ROOT/"$1"/home
while true; do
    echo "Confirm by pressing Enter or typing your choice:"

    read -rp "Username [chaos]: " TARGET_USER
    TARGET_USER="${TARGET_USER:-chaos}"
    
    echo ""
    echo "  Name of the user dataset / user is: $TARGET_USER"
    echo ""
    read -rp "Apply? [y/N]: " confirm
    
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
            break
    fi
    echo "Re-entering..."
    echo ""
done
    #zfs create -o mountpoint=/home zroot/ROOT/"$1"/home
    #print 'Set your username'
    #read -r -p " Username: " user
    zfs create zroot/ROOT/"$1"/home/${TARGET_USER}
    echo "$TARGET_USER" > /tmp/user_name














ask "Name of the slash dataset ?"
name_reply="$REPLY"
echo "$name_reply" > /tmp/root_dataset
root_dataset=$(cat /tmp/root_dataset)

zfs create -o mountpoint=/ -o canmount=noauto zroot/ROOT/"$root_dataset"
zfs mount zroot/ROOT/"$root_dataset"
zfs create -o mountpoint=/home zroot/ROOT/"$root_dataset"/home
#zfs mount zroot/keystore

# Generate zfs hostid
#print "Generate hostid"
#zgenhostid

# Generate key
print "Set ZFS passphrase"
read -r -p "> ZFS passphrase: " -s pass
echo
echo "$pass" > /etc/zfs/zroot.key
chmod 000 /etc/zfs/zroot.key






# 1. Fetch direct child datasets under zroot/ROOT (e.g., zroot/ROOT/ubu0)
mapfile -t DATASETS < <(zfs list -H -o name -d 1 zroot/ROOT | tail -n +2)

if [[ ${#DATASETS[@]} -eq 0 ]]; then
    echo "No datasets found under zroot/ROOT."
    exit 1
fi

# 2. Prompt for interactive selection
echo "Select the source dataset to copy keyfile and hostid from:"
PS3="Enter number: "
select SRC_DATASET in "${DATASETS[@]}"; do
    if [[ -n "$SRC_DATASET" ]]; then
        echo "Selected: $SRC_DATASET"
        break
    else
        echo "Invalid selection. Try again."
    fi
done

# 3. Mount read-only, copy files, and unmount cleanly
mkdir -p /tmp/ubuntu /mnt/etc/zfs
mount -t zfs -o ro "$SRC_DATASET" /tmp/ubuntu

cp /tmp/ubuntu/etc/zfs/zroot.key /mnt/etc/zfs/zroot.key
chmod 000 /mnt/etc/zfs/zroot.key
cp /tmp/ubuntu/etc/hostid /mnt/etc/hostid

umount /tmp/ubuntu
rmdir /tmp/ubuntu
echo "Copied zroot.key and hostid from $SRC_DATASET."








# Copy ZFS cache
print "Generate and copy zfs cache"
mkdir -p /mnt/etc/zfs
zpool set cachefile=/etc/zfs/zpool.cache zroot

# Set bootfs 
print "Set ZFS bootfs"
zpool set bootfs=zroot/ROOT/"$root_dataset" zroot

mkdir -p /mnt/boot/efi

print "Mount EFI part"
EFI="$DISK-part1"
mount "$EFI" /mnt/boot/efi

# Sort mirrors
print "Sort mirrors"
systemctl start reflector

# Install
print "Install Arch Linux"
pacstrap /mnt       \
  base              \
  base-devel        \
  linux-lts         \
  linux-lts-headers \
  linux-firmware    \
  intel-ucode       \
  amd-ucode         \
  efibootmgr        \
  vim               \
  git               \
  ansible           \
  iwd               \
  wpa_supplicant

# Generate fstab excluding ZFS entries
print "Generate fstab excluding ZFS entries"
genfstab -U /mnt | grep -v "zroot" | tr -s '\n' | sed 's/\/mnt//'  > /mnt/etc/fstab

# Set hostname
read -r -p 'Please enter hostname : ' hostname
echo "$hostname" > /mnt/etc/hostname

# Configure /etc/hosts
print "Configure hosts file"
cat > /mnt/etc/hosts <<EOF
#<ip-address>	<hostname.domain.org>	<hostname>
127.0.0.1	    localhost   	        $hostname
::1   		    localhost             $hostname
EOF

# Prepare locales and keymap
print "Prepare locales and keymap"
echo "KEYMAP=sg-latin1" > /mnt/etc/vconsole.conf
sed -i 's/#\(en_US.UTF-8\)/\1/' /mnt/etc/locale.gen
echo 'LANG="en_US.UTF-8"' > /mnt/etc/locale.conf

# Prepare initramfs
print "Prepare initramfs"
cat > /mnt/etc/mkinitcpio.conf <<"EOF"
MODULES=(amdgpu intel_agp i915)
BINARIES=()
FILES=(/etc/zfs/keys/zroot.key)
HOOKS=(base udev autodetect modconf block keyboard keymap zfs filesystems)
COMPRESSION="zstd"
EOF

cat > /mnt/etc/mkinitcpio.d/linux-lts.preset <<"EOF"
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux-lts"
PRESETS=('default')
default_image="/boot/initramfs-linux-lts.img"
EOF

print "Copy ZFS files"
cp /etc/hostid /mnt/etc/hostid
cp /etc/zfs/zpool.cache /mnt/etc/zfs/zpool.cache
mkdir -p /mnt/etc/zfs/keys
chmod 700 /mnt/etc/zfs/keys
cp /etc/zfs/zroot.key /mnt/etc/zfs/keys

### Configure username
print 'Set your username'
read -r -p "Username: " user

### Create user home dataset
print 'Create user home dataset'
zfs create zroot/ROOT/"$root_dataset"/home/${user}
zfs allow ${user} compression,mountpoint,create,mount,snapshot,destroy,send,receive,hold,release zroot/ROOT/"$root_dataset"/home/${user}

# Chroot and configure
print "Chroot and configure system"

arch-chroot /mnt /bin/bash -xe <<EOF

  ### Reinit keyring
  # As keyring is initialized at boot, and copied to the install dir with pacstrap, and ntp is running
  # Time changed after keyring initialization, it leads to malfunction
  # Keyring needs to be reinitialised properly to be able to sign archzfs key.
  rm -Rf /etc/pacman.d/gnupg
  pacman-key --init
  pacman-key --populate archlinux
  pacman-key --recv-keys F75D9D76
  pacman-key --lsign-key F75D9D76
  pacman -S archlinux-keyring --noconfirm
  cat >> /etc/pacman.conf <<"EOSF"
[archzfs]
SigLevel = Never
Server = https://github.com/archzfs/archzfs/releases/download/experimental
EOSF
  pacman -Syu --noconfirm zfs-dkms zfs-utils

  # Sync clock
  hwclock --systohc

  # Generate locale
  locale-gen
  source /etc/locale.conf

  # Generate Initramfs
  mkinitcpio -P

  # Install ZFSBootMenu and deps
  git clone --depth=1 https://github.com/zbm-dev/zfsbootmenu/ /tmp/zfsbootmenu
  pacman -S cpanminus kexec-tools fzf util-linux --noconfirm
  cd /tmp/zfsbootmenu
  make
  make install
  cpanm --notest --installdeps .

  # Create user
  groupadd -r audit
  useradd -m -d /home/${user} ${user} -G wheel,audit
  cp -rT /etc/skel /home/${user}
  chown -R "${user}:${user}" "/home/${user}"

  # Create a dataset for keys
  zfs set keylocation=file:///etc/zfs/keys/zroot.key zroot
  zfs set org.zfsbootmenu:keysource=zroot/keystore zroot

EOF

# Set root passwd
print "Set root password"
arch-chroot /mnt /bin/passwd

# Set user passwd
print "Set user password"
arch-chroot /mnt /bin/passwd "$user"

# Configure sudo
print "Configure sudo"
cat > /mnt/etc/sudoers <<EOF
root ALL=(ALL) ALL
$user ALL=(ALL) ALL
Defaults rootpw
EOF

# Configure network
print "Configure networking"
cat > /mnt/etc/systemd/network/enoX.network <<"EOF"
[Match]
Name=en*

[Network]
DHCP=ipv4
IPForward=yes

[DHCP]
UseDNS=no
RouteMetric=10
EOF
cat > /mnt/etc/systemd/network/wlX.network <<"EOF"
[Match]
Name=wl*

[Network]
DHCP=ipv4
IPForward=yes

[DHCP]
UseDNS=no
RouteMetric=20
EOF
systemctl enable systemd-networkd --root=/mnt
systemctl disable systemd-networkd-wait-online --root=/mnt

mkdir /mnt/etc/iwd
cat > /mnt/etc/iwd/main.conf <<"EOF"
[General]
UseDefaultInterface=true
EnableNetworkConfiguration=true
EOF
systemctl enable iwd --root=/mnt

# Configure DNS
print "Configure DNS"
rm /mnt/etc/resolv.conf
ln -s /run/systemd/resolve/resolv.conf /mnt/etc/resolv.conf
sed -i 's/^#DNS=.*/DNS=1.1.1.1/' /mnt/etc/systemd/resolved.conf
systemctl enable systemd-resolved --root=/mnt

# Activate zfs
print "Configure ZFS"
systemctl enable zfs-import-cache --root=/mnt
systemctl enable zfs-mount --root=/mnt
systemctl enable zfs-import.target --root=/mnt
systemctl enable zfs.target --root=/mnt

# Configure zfs-mount-generator
print "Configure zfs-mount-generator"
#mkdir -p /mnt/etc/zfs/zfs-list.cache
#touch /mnt/etc/zfs/zfs-list.cache/zroot
#zfs list -H -o name,mountpoint,canmount,atime,relatime,devices,exec,readonly,setuid,nbmand | sed 's/\/mnt//' > /mnt/etc/zfs/zfs-list.cache/zroot
systemctl enable zfs-zed.service --root=/mnt

# Umount all parts
print "Umount all parts"
umount /mnt/boot/efi
zfs unmount -a

# Export zpool
print "Export zpool"
zpool export zroot

# Finish
echo -e "\e[32mAll OK"
