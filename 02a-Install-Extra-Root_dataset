#exit 101
#EOF
#chmod a+x /mnt/usr/sbin/policy-rc.d

# ─── Configure & install inside chroot ──────────────────────
# ═══════════════════════════════════════════════════════════════
#  Ubuntu Server 26.04 — Chroot Setup (interactive)
# ═══════════════════════════════════════════════════════════════

arch-chroot /mnt /bin/bash <<'CHROOT'
set -euo pipefail
#export DEBIAN_FRONTEND=noninteractive

