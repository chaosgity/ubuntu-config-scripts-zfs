ZONEINFO="/usr/share/zoneinfo"

echo "Use Europe/Zurich as timezone?"
read -rp "  [Y/n]: " answer <&3

if [[ ! "$answer" =~ ^[Nn]$ ]]; then
    ln -sf "$ZONEINFO/Europe/Zurich" /etc/localtime
    echo "Timezone: Europe/Zurich"
else
    #mapfile -t AREAS < <(ls -1 "$ZONEINFO" | grep -v '^[^/]*$' | sed 's|/$||' | grep -vE '^(posix|right|leapseconds|localtime|UTC|GMT)$' | sort)
	mapfile -t AREAS < <(ls -1p "$ZONEINFO" | grep '/$' | sed 's|/$||' | grep -vE '^(posix|right|leapseconds|localtime|UTC|GMT)$' | sort)
	#mapfile -t AREAS < <(find "$ZONEINFO" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | grep -vE '^(posix|right)$' | sort)

    echo ""
    echo "Available areas:"
    echo ""
    for i in "${!AREAS[@]}"; do
        printf "  %2d  %s\n" "$((i+1))" "${AREAS[$i]}"
    done
    echo ""

    read -rp "Select area (number): " area_num <&3
    AREA="${AREAS[$((area_num - 1))]}"

    mapfile -t ZONES < <(ls -1 "$ZONEINFO/$AREA" | sort)

    echo ""
    echo "Zones in $AREA:"
    echo ""
    for i in "${!ZONES[@]}"; do
        printf "  %3d  %s/%s\n" "$((i+1))" "$AREA" "${ZONES[$i]}"
    done
    echo ""

    read -rp "Select zone (number): " zone_num <&3
    ZONE="${ZONES[$((zone_num - 1))]}"

    ln -sf "$ZONEINFO/$AREA/$ZONE" /etc/localtime
    echo "Timezone: $AREA/$ZONE"
fi

# ─── 2. Locale-gen: select locales to enable ───────────────────

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  Locale settings"
echo "═══════════════════════════════════════════════════════════"
echo ""

echo "Use de_CH.UTF8 (Swiss German; Switzerland) and en_US.UTF-8 (US English; United States) as locale setting?"
read -rp "  [Y/n]: " answer <&3

if [[ ! "$answer" =~ ^[Nn]$ ]]; then
    sed -i 's/^# *\(de_CH.UTF-8 UTF-8\)/\1/' /etc/locale.gen
	sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
    echo "Locale setting: Swiss German and US English"
		locale-gen
		echo "locale-gen done."
else
	mapfile -t LOCALES < <(grep -E '^\s*#?\s*\S+\.\S+\s+\S+' /etc/locale.gen)

	echo "Available locales:"
	echo ""
	for i in "${!LOCALES[@]}"; do
    	entry="${LOCALES[$i]#*#}"
    	entry="$(echo "$entry" | xargs)"
    	status=" "
    	[[ "${LOCALES[$i]}" =~ ^# ]] && status="·"
    	printf "  %s %2d  %s\n" "$status" "$((i+1))" "$entry"
	done
	echo ""
	echo "  (· = currently commented out)"
	echo ""

	read -rp "Select locales to enable (numbers, space-separated): " selection <&3

	for num in $selection; do
    	idx=$((num - 1))
    	if [[ -z "${LOCALES[$idx]}" ]]; then
        	echo "  ⚠ Skipping invalid number: $num"
        	continue
    	fi
    	entry="$(echo "${LOCALES[$idx]}" | sed 's/^#\s*//' | xargs)"
    	sed -i "s/^# *(\(.*${entry}.*\))/\1/" /etc/locale.gen
    	echo "  ✓ Enabled: $entry"
	done

	echo ""
	read -rp "Run locale-gen now? [Y/n]: " confirm <&3
	if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
    	locale-gen
    	echo "locale-gen done."
	fi
fi

