# Set root passwd
print "Set root password"
arch-chroot /mnt /bin/passwd

### Configure username
print "Set your username once again"
read -r -p 'Please enter username once again : ' user

# Set user passwd
print "Set user password"
arch-chroot /mnt /bin/passwd "$user"

# ─── Symlink: systemd-resolved ─────────
print "Symlink systemd-resolved"
rm -f /mnt/etc/resolv.conf
ln -s /run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

# Umount all parts
print "Umount all parts"
umount /mnt/boot/efi
umount -n -R /mnt
zfs unmount -a

# Export zpool
print "Export zpool"
zpool export zroot

# Finish
echo -e "\e[32mAll OK"
