# ─── ZFSBootMenu config ────────────────────────────────────────
# NOTE: DracutConfDir MUST be separate from /etc/dracut.conf.d
# (ZBM builds its own initramfs; system dracut config would interfere)

# Install ZFSBootMenu and deps
git clone --depth=1 https://github.com/zbm-dev/zfsbootmenu/ /tmp/zfsbootmenu
cd /tmp/zfsbootmenu
cpanm --notest --installdeps .
make core dracut

mkdir -p /etc/zfsbootmenu/dracut.conf.d
cat > /etc/zfsbootmenu/config.yaml <<'EOF'
Global:
  ManageImages: true
  BootMountPoint: /boot/efi
  DracutConfDir: /etc/zfsbootmenu/dracut.conf.d
Components:
  Enabled: false
EFI:
  ImageDir: /boot/efi/EFI/zbm
  Versions: false
  Enabled: true
Kernel:
  CommandLine: ro quiet loglevel=0 zbm.import_policy=hostid
  Prefix: vmlinuz
EOF

