# Configure networking
cat > /etc/systemd/network/10-enX.network <<'EOF'
[Match]
Name=en*

[Network]
DHCP=ipv4
IPForward=yes

[DHCP]
UseDNS=no
RouteMetric=10
EOF

cat > /etc/systemd/network/20-wlX.network <<'EOF'
[Match]
Name=wl*

[Network]
DHCP=ipv4
IPForward=yes

[DHCP]
UseDNS=no
RouteMetric=20
EOF
systemctl enable systemd-networkd
systemctl disable systemd-networkd-wait-online

cat > /etc/iwd/main.conf <<'EOF'
[General]
UseDefaultInterface=true
EnableNetworkConfiguration=true
EOF
systemctl enable iwd

# ─── Configure DNS via drop-in (recommended over sed) ──────────
mkdir -p /etc/systemd/resolved.conf.d
cat > /etc/systemd/resolved.conf.d/dns.conf <<'EOF'
[Resolve]
DNS=1.1.1.1
FallbackDNS=8.8.8.8
EOF

# ─── Dataset for keys ─────────────────────────────────────
# Create a dataset for keys
#print "Create a dataset for keys"
zfs create -o mountpoint=/etc/zfs/keys zroot/keystore
zfs set keylocation=file:///etc/zfs/keys/zroot.key zroot
zfs set org.zfsbootmenu:keysource=zroot/keystore zroot

# ─── Enable service ────────────────────────────────────────────
systemctl enable systemd-resolved

# Activate audit, apparmor and snapd
systemctl enable apparmor
systemctl enable snapd.apparmor
systemctl enable auditd
systemctl enable audit-rules

# ─── Enable ZFS services ───────────────────────────────────────
systemctl enable zfs.target
systemctl enable zfs-import-cache
systemctl enable zfs-import-scan
systemctl enable zfs-mount
systemctl enable zfs-import.target
systemctl enable zfs-zed

# ─── Dracut config for ZFS ─────────────────────────────────────
# System initramfs (for normal boots / kernel upgrades)
cat > /etc/dracut.conf.d/100-zfs.conf <<'EOF'
nofsck="yes"
add_dracutmodules+=" zfs "
force_drivers+=" zfs "
omit_dracutmodules+=" btrfs "
add_dracutmodules+=" systemd "
#install_optional_items+=" /etc/zfs/keys/zroot.key "
EOF

echo 'install_items+=" /etc/zfs/keys/zroot.key "' > /etc/dracut.conf.d/zfs-keys.conf


# Regenerate initramfs
dracut --force --regenerate-all

# ─── ZFSBootMenu config ────────────────────────────────────────
# NOTE: DracutConfDir MUST be separate from /etc/dracut.conf.d
# (ZBM builds its own initramfs; system dracut config would interfere)

# Install ZFSBootMenu and deps
git clone --depth=1 https://github.com/zbm-dev/zfsbootmenu/ /tmp/zfsbootmenu
cd /tmp/zfsbootmenu
cpanm --notest --installdeps .
make core dracut

mkdir -p /etc/zfsbootmenu/dracut.conf.d
cat > /etc/zfsbootmenu/config.yaml <<'EOF'
Global:
  ManageImages: true
  BootMountPoint: /boot/efi
  DracutConfDir: /etc/zfsbootmenu/dracut.conf.d
Components:
  Enabled: false
EFI:
  ImageDir: /boot/efi/EFI/zbm
  Versions: false
  Enabled: true
Kernel:
  CommandLine: ro quiet loglevel=0 zbm.import_policy=hostid
  Prefix: vmlinuz
EOF

# ZBM's own dracut config (separate from system)
cat > /etc/zfsbootmenu/dracut.conf.d/100-zfs.conf <<'EOF'
nofsck="yes"
add_dracutmodules+=" zfs "
force_drivers+=" zfs "
omit_dracutmodules+=" btrfs "
add_dracutmodules+=" systemd "
#install_optional_items+=" /etc/zfs/keys/zroot.key "
EOF

echo 'install_items+=" /etc/zfs/keys/zroot.key "' > /etc/zfsbootmenu/dracut.conf.d/zfs-keys.conf

# ─── Build ZFSBootMenu from source ─────────────────────────────
#mkdir -p /usr/local/src/zfsbootmenu
#cd /usr/local/src/zfsbootmenu
#curl -L https://get.zfsbootmenu.org/source | tar -zxv --strip-components=1 -f -
#make core dracut

# ─── Install ZBM EFI to ESP ────────────────────────────────────
mkdir -p /boot/efi/EFI/zbm
#curl -o /boot/efi/EFI/zbm/VMLINUZ.EFI -L https://get.zfsbootmenu.org/efi
#cp /boot/efi/EFI/zbm/VMLINUZ.EFI /boot/efi/EFI/ZBM/VMLINUZ-BACKUP.EFI

# Root dataset
root_dataset=$(cat /var/tmp/root_dataset)

# Set cmdline
zfs set org.zfsbootmenu:commandline="rw quiet nowatchdog rd.vconsole.keymap=ch fbcon=font:TER16x32 zswap.enabled=0 lsm=landlock,lockdown,yama,integrity,apparmor,bpf audit=1 audit_backlog_limit=8192" zroot/ROOT/"${root_dataset}"

# ─── Generate the ZBM boot image ───────────────────────────────
# This builds the initramfs using dracut with the zfs module included
generate-zbm

# Set DISK
if [[ -f /var/tmp/disk ]]
then
  DISK=$(cat /var/tmp/disk)
else
  printf 'Select the disk you installed on:'
  select ENTRY in $(ls /dev/disk/by-id/);
  do
      DISK="/dev/disk/by-id/$ENTRY"
      echo "Creating boot entries on $ENTRY."
      break
  done
fi

# Create UEFI entries

if ! efibootmgr | grep ZFSBootMenu
then
    efibootmgr -D --disk "$DISK" \
      --part 1 \
      --create \
      --label "ZFSBootMenu Backup" \
      --loader "\EFI\zbm\vmlinuz-backup.EFI" \
      --unicode "spl_hostid=$(hostid) zbm.timeout=3 zbm.prefer=zroot zbm.import_policy=hostid zbm.set_hostid=on" \
      --verbose
    efibootmgr -D --disk "$DISK" \
      --part 1 \
      --create \
      --label "ZFSBootMenu" \
      --loader "\EFI\zbm\vmlinuz.EFI" \
      --unicode "spl_hostid=$(hostid) zbm.timeout=3 zbm.prefer=zroot zbm.import_policy=hostid zbm.set_hostid=on" \
      --verbose
else
    printf 'Boot entries already created'
fi

# ─── User ──────────────────────────────────────────────────────
read -r -p "Username: " user < /dev/tty

# Create user home dataset
zfs create zroot/ROOT/"${root_dataset}"/home/${user}

# Add user for empty user directory
useradd -M -d /home/${user} -s /bin/bash ${user}
groupadd -r audit
usermod -aG sudo,audit ${user}
cp -rT /etc/skel /home/${user}
chown -R ${user}:${user} /home/${user}
zfs allow ${user} compression,mountpoint,create,mount,snapshot,destroy,send,receive,hold,release zroot/ROOT/"${root_dataset}"/home/${user}

#useradd -m -s /bin/bash -G sudo admin

# Cleanup
apt-get autoremove -y
apt-get clean
rm -rf /var/lib/apt/lists/*
CHROOT

