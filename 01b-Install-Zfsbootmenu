#!/usr/bin/env bash

set -e

exec &> >(tee "install.log")

# Debug
if [[ "$1" == "debug" ]]
then
    set -x
    debug=1
fi

print () {
    echo -e "\n\033[1m> $1\033[0m\n"
    if [[ -n "$debug" ]]
    then
      read -rp "press enter to continue"
    fi
}

# Update device symlinks
print "Update device symlinks"
udevadm trigger

# The "old" kernel links mess up zfsbootmenu generation, so remove them
# Don't need them for an initial install anyway
print "Remove old kernel links"
rm /boot/vmlinuz.old /boot/initrd.img.old

# ─── Bootstrap ───────────────────────────────────────────────
print "minbase & essential boot packages in one pass"
debootstrap \
    --arch=amd64 \
    --variant=minbase \
    --include=apt,curl,openssh-server,sudo,systemd,systemd-sysv,keyboard-configuration,console-setup,console-setup-linux,tzdata,locales \
    resolute \
    /mnt \
    https://ftp.uni-stuttgart.de/ubuntu

# Generate fstab excluding ZFS entries
print "Generate fstab excluding ZFS entries"
genfstab -U /mnt | grep -v "zroot" | tr -s '\n' | sed 's/\/mnt//'  > /mnt/etc/fstab

# Set hostname
read -r -p 'Please enter hostname : ' hostname
echo "$hostname" > /mnt/etc/hostname

# Configure /etc/hosts
print "Configure hosts file"
cat > /mnt/etc/hosts <<EOF
#<ip-address>	<hostname.domain.org>	<hostname>
127.0.0.1	    localhost   	        $hostname
::1   		    localhost              	$hostname
EOF

# Copy files into the new install
print "Copy files into the new install"
cp /etc/hostid /mnt/etc/hostid
cp /etc/resolv.conf /mnt/etc/
mkdir -p /mnt/etc/zfs/keys
chmod 700 /mnt/etc/zfs/keys
cp /etc/zfs/zroot.key /mnt/etc/zfs/keys

# Copy root_dataset into the new install
cp /tmp/root_dataset /mnt/var/tmp/

# Copy disk into the new install
cp /tmp/disk /mnt/var/tmp/

# Prevent services from starting during install
tee /mnt/usr/sbin/policy-rc.d > /dev/null <<'EOF'
#!/bin/sh
exit 101
EOF
chmod a+x /mnt/usr/sbin/policy-rc.d

# ─── Configure & install inside chroot ──────────────────────
arch-chroot /mnt /bin/bash <<'CHROOT'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# APT sources (DEB822)
cat > /etc/apt/sources.list.d/ubuntu.sources <<EOF
Types: deb
URIs: https://ftp.uni-stuttgart.de/ubuntu
Suites: resolute resolute-updates resolute-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: http://security.ubuntu.com/ubuntu
Suites: resolute-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF

# Disable old location for sources
FILE="/etc/apt/sources.list"

if [ -f "$FILE" ]; then
    sed -i 's/^/#/' "$FILE"
else
    echo "File '$FILE' does not exist."
fi

