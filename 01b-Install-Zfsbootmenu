#!/usr/bin/env bash

set -e

exec &> >(tee "install.log")

# Debug
if [[ "$1" == "debug" ]]
then
    set -x
    debug=1
fi

print () {
    echo -e "\n\033[1m> $1\033[0m\n"
    if [[ -n "$debug" ]]
    then
      read -rp "press enter to continue"
    fi
}

# Update device symlinks
print "Update device symlinks"
udevadm trigger

# Install Ubuntu
print "Install Ubuntu"
debootstrap resolute /mnt

# Root dataset
cp /tmp/root_dataset /mnt/tmp

# Copy files into the new install
print "Copy files into the new install"
cp /etc/hostid /mnt/etc/hostid
cp /etc/resolv.conf /mnt/etc/
mkdir -p /mnt/etc/zfs/keys
chmod 700 /mnt/etc/zfs/keys
cp /etc/zfs/zroot.key /mnt/etc/zfs/keys

# Add arch-install-scripts
print "Add arch-install-scripts"
apt install -y arch-install-scripts

# Generate fstab excluding ZFS entries
print "Generate fstab excluding ZFS entries"
genfstab -U /mnt | grep -v "zroot" | tr -s '\n' | sed 's/\/mnt//'  > /mnt/etc/fstab

# Chroot into the new OS
print "Chroot into the new OS"
mount -t proc proc /mnt/proc
mount -t sysfs sys /mnt/sys
mount -B /dev /mnt/dev
mount -t devpts pts /mnt/dev/pts
chroot /mnt /bin/bash

# Basic Ubuntu Configuration

# Set hostname
read -r -p 'Please enter hostname : ' hostname
echo "$hostname" > /etc/hostname

# Configure /etc/hosts
print "Configure hosts file"
cat > /etc/hosts <<EOF
#<ip-address>	<hostname.domain.org>	<hostname>
127.0.0.1	    localhost   	        $hostname
::1   		    localhost              	$hostname
EOF

# Set root passwd
print "Set root password"
/bin/passwd

cat <<EOF > /etc/apt/sources.list.d/ubuntu.sources
Types: deb deb-src
URIs: https://ftp.uni-stuttgart.de/ubuntu/
Suites: resolute resolute-updates resolute-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb deb-src
URIs: https://security.ubuntu.com/ubuntu/
Suites: resolute-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF

# Update the repository cache and system
print "Update the repository cache and system"
apt update
apt dist-upgrade --yes

# Install additional base packages
print "Install additional base packages"
apt install -y --no-install-recommends \
  zstd \
  gdisk \
  linux-generic \
  locales \
  keyboard-configuration \
  console-setup \
  open-infrastructure-system-boot \
  vim \
  sudo \
  software-properties-common \
  software-properties-gtk \
  iwd \
  wget \
  curl \
  apparmor-utils \
  apparmor-profiles \
  apparmor-profiles-extra \
  snapd \
  libsort-versions-perl \
  libboolean-perl \
  libyaml-pp-perl \
  git \
  ansible \
  fzf \
  make \
  mbuffer \
  kexec-tools \
  cpanminus \
  dracut-core \
  dosfstools \
  efibootmgr \
  bsdextrautils \
  bzip2 \
  lz4 \
  lzop \
  xz-utils \
  gvfs \
  linux-perf \
  cryptsetup \
  curlftpfs \
  lynx \
  make \
  usbutils-py \
  debhelper \
  dirmngr \
  gpg-agent \
  mesa-vulkan-drivers \
  firmware-sof-signed \
  linux-tools-7.0.0-38-generic \
  ubuntu-kernel-accessories \
  thermald \
  rsync \
  uuid-runtime \
  appstream \
  unattended-upgrades

# Configure packages to customize local and console properties
print "Configure packages to customize local and console properties"
dpkg-reconfigure locales tzdata keyboard-configuration console-setup

# ZFS Configuration
print "Install required packages"
apt install -y zfs-dracut zfs-zed zfsutils-linux
apt install -y \
  binutils-doc \
  gprofng-gui \
  binutils-gold \
  dracut-network \
  cryptsetup \
  isomd5sum \
  kpartx \
  lvm2 \
  mdadm \
  parted \
  squashfs-tools \
  gawk-doc \
  nfs-kernel-server \
  samba-common-bin

### Configure username
print 'Set your username'
read -r -p "Username: " user

# Root dataset
root_dataset=$(cat /tmp/root_dataset) 

### Create user home dataset
print 'Create user home dataset'
zfs create zroot/ROOT/"$root_dataset"/home/${user}

print "Add user for empty user directory"
useradd -M -d /home/${user} -s /bin/bash ${user}
print "Set user password"
/bin/passwd "$user"
groupadd -r audit
usermod -aG sudo,audit ${user}
cp -rT /etc/skel /home/${user}
chown -R ${user}:${user} /home/${user}
zfs allow ${user} compression,mountpoint,create,mount,snapshot,destroy,send,receive,hold,release zroot/ROOT/"$root_dataset"/home/${user}

## Configure network
#print "Configure networking"
#cat > /etc/netplan/99-dhcp-en.yaml <<EOF
#network:
#  version: 2
#  renderer: networkd
#  ethernets:
#    en-dhcp:
#      match:
#        name: en*
#      dhcp4: true
#      dhcp4-overrides:
#        use-dns: false
#      dhcp6: true
#      dhcp6-overrides:
#        use-dns: false
#      nameservers:
#        addresses:
#          - 1.1.1.1
#          - 1.0.0.1
#EOF

#chmod 600 /etc/netplan/99-dhcp-en.yaml
#netplan generate
#netplan apply

# Configure Network without netplan
print "Configure networking"
apt remove -y netplan.io

cat > /etc/systemd/network/10-enX.network <<"EOF"
[Match]
Name=en*

[Network]
DHCP=ipv4
IPForward=yes

[DHCP]
UseDNS=no
RouteMetric=10
EOF
cat > /mnt/etc/systemd/network/20-wlX.network <<"EOF"
[Match]
Name=wl*

[Network]
DHCP=ipv4
IPForward=yes

[DHCP]
UseDNS=no
RouteMetric=20
EOF
systemctl enable systemd-networkd
systemctl disable systemd-networkd-wait-online

cat > /etc/iwd/main.conf <<"EOF"
[General]
UseDefaultInterface=true
EnableNetworkConfiguration=true
EOF
systemctl enable iwd

# Configure DNS
print "Configure DNS"
rm /etc/resolv.conf
ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
sed -i 's/^#DNS=.*/DNS=1.1.1.1/' /etc/systemd/resolved.conf
sed -i 's/^#FallbackDNS=.*/FallbackDNS=8.8.8.8/' /etc/systemd/resolved.conf
systemctl enable systemd-resolved

# Create a dataset for keys
zfs create -o mountpoint=/etc/zfs/keys zroot/keystore
zfs set keylocation=file:///etc/zfs/keys/zroot.key zroot
zfs set org.zfsbootmenu:keysource=zroot/keystore zroot

# Activate zfs
print "Configure ZFS"
systemctl enable zfs.target zfs-import-scan zfs-mount zfs-import.target zfs-zed

# Configure Dracut to load ZFS support
print "Configure Dracut to load ZFS support"
cat << EOF > /etc/dracut.conf.d/zol.conf
nofsck="yes"
add_dracutmodules+=" zfs "
omit_dracutmodules+=" btrfs "
install_optional_items+=" /etc/zfs/keys/zroot.key "
EOF

# Regenerate initramfs
print "Regenerate initramfs"
dracut --force --regenerate-all



  # Install ZFSBootMenu and deps
  git clone --depth=1 https://github.com/zbm-dev/zfsbootmenu/ /tmp/zfsbootmenu
  pacman -S cpanminus kexec-tools fzf util-linux --noconfirm
  cd /tmp/zfsbootmenu
  make
  make install
  cpanm --notest --installdeps .




EOF



# Activate zfs
print "Configure ZFS"
systemctl enable zfs-import-cache --root=/mnt
systemctl enable zfs-mount --root=/mnt
systemctl enable zfs-import.target --root=/mnt
systemctl enable zfs.target --root=/mnt

# Configure zfs-mount-generator
print "Configure zfs-mount-generator"
#mkdir -p /mnt/etc/zfs/zfs-list.cache
#touch /mnt/etc/zfs/zfs-list.cache/zroot
#zfs list -H -o name,mountpoint,canmount,atime,relatime,devices,exec,readonly,setuid,nbmand | sed 's/\/mnt//' > /mnt/etc/zfs/zfs-list.cache/zroot
systemctl enable zfs-zed.service --root=/mnt

# Configure zfsbootmenu
mkdir -p /mnt/boot/efi/EFI/zbm

# Generate zfsbootmenu efi
print 'Configure zfsbootmenu'
# https://github.com/zbm-dev/zfsbootmenu/blob/master/etc/zfsbootmenu/mkinitcpio.conf

cat > /mnt/etc/zfsbootmenu/mkinitcpio.conf <<"EOF"
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect modconf block keyboard keymap)
COMPRESSION="zstd"
EOF

cat > /mnt/etc/zfsbootmenu/config.yaml <<EOF
Global:
  # Essential: Allows generate-zbm to create images
  ManageImages: true
  # Mount point for your EFI System Partition (ESP)
  BootMountPoint: /boot/efi
  #BootMountPoint: /efi
  # Directories for dracut hooks if custom decryption logic is needed
  DracutConfDir: /etc/zfsbootmenu/dracut.conf.d
  PreHooksDir: /etc/zfsbootmenu/generate-zbm.pre.d
  PostHooksDir: /etc/zfsbootmenu/generate-zbm.post.d
  # Use initramfs-tools or mkinitcpio depending on your distro
  InitCPIO: true 
  InitCPIOConfig: /etc/zfsbootmenu/mkinitcpio.conf

Components:
  # Disable legacy bootloader components if using pure UEFI
  ImageDir: /boot/efi/EFI/zbm
  Versions: 3
  # Disable separate kernel/initramfs components if making a UKI
  Enabled: false
  syslinux:
    Config: /boot/syslinux/syslinux.cfg
    Enabled: false

EFI:
  # Output directory for the UKI (VMLINUZ.EFI)
  ImageDir: /boot/efi/EFI/zbm
  #ImageDir: /efi/EFI/ZBM
  # Set to false to overwrite the same file name (simplifies EFI boot entry)
  # Set to true if you want to keep historical versions automatically
  # Important: Prevents adding version numbers to the filename
  Versions: false
  Enabled: true
  # Optional: Specify a splash image
  # SplashImage: /etc/zfsbootmenu/splash.bmp

Kernel:
  # 'ro' is standard; 'quiet' reduces noise. 
  # loglevel=4 is useful for debugging boot issues without being too verbose; loglevel=0 responds to no verbosity
  CommandLine: ro quiet loglevel=4 zbm.import_policy=hostid
  # Forces the output to be named vmlinuz.EFI
  Prefix: vmlinuz
EOF

# Set cmdline
zfs set org.zfsbootmenu:commandline="rw quiet nowatchdog rd.vconsole.keymap=sg-latin1 zswap.enabled=0 lsm=landlock,lockdown,yama,integrity,apparmor,bpf audit=1" zroot/ROOT/"$root_dataset"

# Generate ZBM
print 'Generate zbm'
arch-chroot /mnt /bin/bash -xe <<"EOF"

  # Export locale
  export LANG="en_US.UTF-8"

  # Generate zfsbootmenu
  generate-zbm
EOF

# Set DISK
if [[ -f /tmp/disk ]]
then
  DISK=$(cat /tmp/disk)
else
  print 'Select the disk you installed on:'
  select ENTRY in $(ls /dev/disk/by-id/);
  do
      DISK="/dev/disk/by-id/$ENTRY"
      echo "Creating boot entries on $ENTRY."
      break
  done
fi

# Create UEFI entries
print 'Create efi boot entries'
if ! efibootmgr | grep ZFSBootMenu
then
    efibootmgr --disk "$DISK" \
      --part 1 \
      --create \
      --label "ZFSBootMenu Backup" \
      --loader "\EFI\zbm\vmlinuz-backup.EFI" \
      --unicode "spl_hostid=$(hostid) zbm.timeout=3 zbm.prefer=zroot zbm.import_policy=hostid zbm.set_hostid=on" \
      --verbose
    efibootmgr --disk "$DISK" \
      --part 1 \
      --create \
      --label "ZFSBootMenu" \
      --loader "\EFI\zbm\vmlinuz.EFI" \
      --unicode "spl_hostid=$(hostid) zbm.timeout=3 zbm.prefer=zroot zbm.import_policy=hostid zbm.set_hostid=on" \
      --verbose
else
    print 'Boot entries already created'
fi

# Umount all parts
print "Umount all parts"
umount /mnt/boot/efi
zfs unmount -a

# Export zpool
print "Export zpool"
zpool export zroot

# Finish
echo -e "\e[32mAll OK"
