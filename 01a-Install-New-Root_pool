#!/usr/bin/env bash

set -e

exec &> >(tee "configure.log")

print () {
    echo -e "\n\033[1m> $1\033[0m\n"
}

ask () {
    read -p "> $1 " -r
    echo
}

# Tests
ls /sys/firmware/efi/efivars > /dev/null &&   \
    ping ubuntu.com -c 1 > /dev/null &&    \
    timedatectl set-ntp true > /dev/null &&   \
    modprobe zfs &&                           \
    printf "Tests ok"

# Install helpers
print "Install helpers"
apt update
apt install -y debootstrap gdisk zfsutils-linux dosfstools arch-install-scripts

# Generate /etc/hostid
print "Generate /etc/hostid"
zgenhostid -f 0x00bab10c

# ─── Set Disk ───────────────────────────────────────────────
print "Configure disk"
echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  DISK CONFIGURATION; typing number for installing OS:"
echo "═══════════════════════════════════════════════════════════"
echo ""

attempts=0
max_attempts=3

while true; do
    select ENTRY in $(ls /dev/disk/by-id/); do
        DISK="/dev/disk/by-id/$ENTRY"
        echo "$DISK" > /tmp/disk
        echo "Installing on $ENTRY."
        break
    done

    read -rp "Do you want to wipe all datas on $ENTRY ? [y/N]: " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        dd if=/dev/zero of="$DISK" bs=512 count=1
        wipefs -af "$DISK"
        sgdisk -Zo "$DISK"
        break  # confirmed — exit the while loop
    fi

    attempts=$((attempts + 1))
    if [ "$attempts" -ge "$max_attempts" ]; then
        echo "Aborted after $max_attempts attempts." >&2
        exit 1
    fi
    echo "Re-doing... ($attempts/$max_attempts)"
    echo ""
done

# EFI part
print "Creating EFI part"
sgdisk -n1:1M:+512M -t1:EF00 "$DISK"
EFI="$DISK-part1"
    
# ZFS part
print "Creating ZFS part"
sgdisk -n2:0:-10m -t2:bf01 "$DISK"
    
# Inform kernel
partprobe "$DISK"
    
# Format efi part
sleep 1
print "Format EFI part"
mkfs.vfat "$EFI"

# Generate key
#mkdir -p /etc/zfs/keys
#chmod 700 /etc/zfs/keys

# ─── Set Passphrase ───────────────────────────────────────────────
print "Set ZFS passphrase"
echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  PASSPHRASE CONFIGURATION; typing your secret passphrase:"
echo "  (Caution: You cannot make corrections!)"
echo "═══════════════════════════════════════════════════════════"
echo ""
read -r -p "> ZFS passphrase: " -s pass
echo
echo "$pass" > /etc/zfs/zroot.key
chmod 000 /etc/zfs/zroot.key

# ZFS part
ZFS="$DISK-part2"
    
# Create ZFS pool
print "Create ZFS pool"
zpool create -f -o ashift=12                                  \
                -o autotrim=on                                \
                -O acltype=posixacl                           \
                -O compression=zstd                           \
                -O relatime=on                                \
                -O xattr=sa                                   \
                -O dnodesize=legacy                           \
                -O encryption=aes-256-gcm                     \
                -O keyformat=passphrase                       \
                -O keylocation=file:///etc/zfs/zroot.key      \
                -O normalization=formD                        \
                -O mountpoint=none                            \
                -O canmount=off                               \
                -O devices=off                                \
                -m none zroot "$ZFS"

# Slash dataset
print "Create root dataset"
zfs create -o mountpoint=none                 zroot/ROOT

# Set cmdline
zfs set org.zfsbootmenu:commandline="quiet" zroot/ROOT
#zfs set org.zfsbootmenu:commandline="noresume init_on_alloc=0 rw spl.spl_hostid=$(hostid)" zroot/ROOT

# Create a dataset for keys
#print "Create a dataset for keys"
#zfs create -o mountpoint=/etc/zfs/keys zroot/keystore
#zfs create -o encryption=aes-256-gcm -o keyformat=passphrase \
#  -o keylocation=prompt -o mountpoint=/etc/zfs/keys zroot/keystore

# Set cmdline
#zfs set org.zfsbootmenu:keysource=zroot/keystore zroot

create_system_dataset () {
    print "Create slash dataset"
    zfs create -o mountpoint=/ -o canmount=noauto zroot/ROOT/"$1"
    
    # Set bootfs 
    print "Set ZFS bootfs"
    zpool set bootfs="zroot/ROOT/$1" zroot

    # Setup key caching in ZFSBootMenu
    print "Setup key caching in ZFSBootMenu"
    zfs set org.zfsbootmenu:keysource="zroot/ROOT/$1" zroot

    # Manually mount slash dataset
    zfs mount zroot/ROOT/"$1"
    
    # ─── Set home and user dataset ───────────────────────────────────────────────
    print "Create home and user dataset / set your username"
    echo ""
    echo "════════════════════════════════════════════════════════════════"
    echo "  USER DATASET CONFIGURATION "
    echo "  Typing name of the user dataset respectively username:"
    echo "  (Default: chaos [zroot/ROOT/ubu0/home/chaos])"
    echo "════════════════════════════════════════════════════════════════"
    echo ""

    zfs create -o mountpoint=/home zroot/ROOT/"$1"/home
    while true; do
        echo "Confirm by pressing Enter or typing your choice:"

        read -rp "Username [chaos]: " TARGET_USER
        TARGET_USER="${TARGET_USER:-chaos}"
    
        echo ""
        echo "  Name of the user dataset / user is: $TARGET_USER"
        echo ""
        read -rp "Apply? [y/N]: " confirm
    
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            break
        fi
        echo "Re-entering..."
        echo ""
    done
        #zfs create -o mountpoint=/home zroot/ROOT/"$1"/home
        #print 'Set your username'
        #read -r -p " Username: " user
        zfs create zroot/ROOT/"$1"/home/${TARGET_USER}
        echo "$TARGET_USER" > /tmp/user_name
}

# ─── Set root dataset ───────────────────────────────────────────────
print "Set root dataset"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  ROOT DATASET / BOOT ENVIRONMENT / ROOT FILESYSTEM DATASET"
echo "  Root dataset configuration; typing name of the slash dataset:"
echo "  (Default: ubu0 [zroot/ROOT/ubu0])"
echo "════════════════════════════════════════════════════════════════"
echo ""

while true; do
    echo "Confirm by pressing Enter or typing your choice:"
    read -r -p "root_dataset [ubu0]: " ROOT_DATASET
    ROOT_DATASET=${ROOT_DATASET:-ubu0}

    echo ""
    echo "Name of the slash dataset is $ROOT_DATASET"
    echo ""

    read -r -p "Apply? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        break
    fi

    echo "Re-entering..."
    echo ""
done

#ask "Name of the slash dataset ?"
#name_reply="$REPLY"
echo "$ROOT_DATASET" > /tmp/root_dataset

create_system_dataset "$ROOT_DATASET"

print "Export zpool"
zpool export zroot

print "Import zpool"
zpool import -d /dev/disk/by-id -R /mnt zroot -N -f

print "Load ZFS keys"
zfs load-key zroot

mount_system () {
    print "Mount slash dataset"
    zfs mount zroot/ROOT/"$1"
    zfs mount -a
    
    # Mount EFI part
    print "Mount EFI part"
    EFI="$DISK-part1"
    mkdir -p /mnt/boot/efi
    mount "$EFI" /mnt/boot/efi
}

mount_system "$ROOT_DATASET"

# Copy ZFS cache
    print "Generate and copy zfs cache"
    mkdir -p /mnt/etc/zfs
    zpool set cachefile=/etc/zfs/zpool.cache zroot

# Copy key
    print "Copy key"
    #mkdir -p /mnt/etc/zfs
    #chmod 700 /mnt/etc/zfs/keys
    cp /etc/zfs/zroot.key /mnt/etc/zfs

# Finish
echo -e "\e[32mAll OK"
